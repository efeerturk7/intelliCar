# Bu dosyayı .env adıyla kopyala ve değerleri doldur: cp .env.example .env
POSTGRES_DB=intellicar_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=degistir_guclu_bir_sifre
# En az 32 karakter. Üretmek için: openssl rand -hex 32
JWT_SECRET=degistir_en_az_32_karakterlik_rastgele_bir_deger
# Google AI Studio API anahtarı: https://aistudio.google.com/apikey
GEMINI_API_KEY=degistir_gemini_api_anahtarin
# İsteğe bağlı. Boş bırakırsan gemini-3.8-flash kullanılır. Model bulunamadı (404) hatası alırsan AI Studio'daki güncel model listesine bak.
# GEMINI_MODEL=gemini-3.8-flash
